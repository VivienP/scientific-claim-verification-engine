# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Scientific APIs (Phase 0+) ───────────────────────────────────────────────
# Semantic Scholar — free tier, no key required; set if you have an API key
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall — requires a registered email address
UNPAYWALL_EMAIL=your@email.com

# ─── Pipeline config ─────────────────────────────────────────────────────────
# Model used for claim extraction and verification
CLAUDE_MODEL=claude-sonnet-4-6

# Output directory for verification reports
OUTPUT_DIR=./output

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
